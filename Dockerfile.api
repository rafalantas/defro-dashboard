FROM python:3.12-alpine
WORKDIR /app
COPY api.py /app/api.py
COPY fuel.py thermoflow2_runtime.py /app/
COPY fuel_engine.py /app/fuel_engine.py
COPY fuel_runtime.py /app/fuel_runtime.py
COPY fuel_config.py /app/fuel_config.py
COPY fuel_stats_service.py /app/fuel_stats_service.py
COPY fuel_errors.py /app/fuel_errors.py
COPY fuel_http.py /app/fuel_http.py
COPY fuel_estimates.py /app/fuel_estimates.py
COPY fuel_period_analysis.py /app/fuel_period_analysis.py
COPY fuel_models.py /app/fuel_models.py
COPY fuel_daily_model.py /app/fuel_daily_model.py
COPY fuel_summary_metrics.py /app/fuel_summary_metrics.py
COPY fuel_refills.py /app/fuel_refills.py
COPY fuel_refill_provider.py /app/fuel_refill_provider.py
COPY fuel_refill_service.py /app/fuel_refill_service.py
COPY fuel_counter.py /app/fuel_counter.py
COPY fuel_counter_provider.py /app/fuel_counter_provider.py
COPY fuel_energy.py /app/fuel_energy.py
COPY fuel_planning.py /app/fuel_planning.py
COPY fuel_schema.py /app/fuel_schema.py
COPY fuel_ai.py /app/fuel_ai.py
COPY fuel_telemetry.py /app/fuel_telemetry.py
COPY fuel_telemetry_provider.py /app/fuel_telemetry_provider.py
COPY fuel_weather_provider.py /app/fuel_weather_provider.py
COPY fuel_thingspeak_daily_provider.py /app/fuel_thingspeak_daily_provider.py
COPY fuel_daily_provider.py /app/fuel_daily_provider.py
COPY fuel_daily_service.py /app/fuel_daily_service.py
COPY fuel_summary_service.py /app/fuel_summary_service.py
COPY fuel_summary_runtime.py /app/fuel_summary_runtime.py
COPY fuel_prefetch_service.py /app/fuel_prefetch_service.py
COPY fuel_climate_provider.py /app/fuel_climate_provider.py
EXPOSE 8000
CMD ["python", "-u", "/app/api.py"]
COPY fuel_summary_estimates.py /app/fuel_summary_estimates.py

COPY fuel_house_model.py /app/fuel_house_model.py

COPY fuel_telemetry_audit_service.py /app/fuel_telemetry_audit_service.py
