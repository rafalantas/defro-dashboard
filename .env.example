# Wklej świeży token eModul. Nie zapisuj prawdziwego tokenu w GitHubie.
TECH_API_TOKEN=

# Opcjonalnie, jeśli konto ma więcej niż jeden sterownik:
TECH_MODULE_ID=

# Opcjonalnie: token tunelu Cloudflare. Aktywuj usługę profilem cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=

# Opcjonalnie: zużycie peletu w osobnym kanale ThingSpeak (pola: kg, notatka, anulowany_wpis).
THINGSPEAK_FUEL_CHANNEL_ID=
THINGSPEAK_FUEL_WRITE_KEY=
THINGSPEAK_FUEL_READ_KEY=
# Token do dodawania dosypek przez POST /api/fuel/refill (np. openssl rand -hex 24).
FUEL_API_TOKEN=
# Współrzędne domu do stopniodni z Open-Meteo dla dni sprzed kanału temperatur.
FUEL_LAT=
FUEL_LON=
# Zmiana wydajności podajnika: licznik ma od tej chwili inny współczynnik kg na 1 % (ISO 8601).
FUEL_COUNTER_EPOCH=
